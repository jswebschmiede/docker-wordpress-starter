# Container Configuration
CONTAINER_PREFIX=your-project-name

# Database Configuration
DB_NAME=wordpress
DB_PASSWORD=your_secure_db_password
DB_USER=wordpress

# WordPress Configuration
WORDPRESS_VERSION=php8.3-fpm
WORDPRESS_CLI_VERSION=php8.3
NGINX_VERSION=1.30-alpine
CADDY_VERSION=2.11.4-alpine

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_PORT=3306
MYSQL_VERSION=8.4.2

# Project Configuration
PROJECT_NAME=your-project-name
WEB_PORT=6969

# WordPress Admin (for WP-CLI core install)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=your_secure_admin_password
WP_ADMIN_EMAIL=admin@example.com
WP_URL=https://127.0.0.1:6969

# WordPress Locale (optional). Examples: de_DE, en_US. Empty = default (en_US).
WP_LANG=de_DE

# Plugin slugs from wordpress.org to install and activate (optional). Space-separated.
# Example: PLUGINS_SLUGS=akismet contact-form-7
PLUGINS_SLUGS=simple-smtp performance-lab redux-framework query-monitor secure-custom-fields

# Additional Services
MAILPIT_VERSION=latest
PHPMYADMIN_VERSION=5.2-apache

# Content (optional)
# Space-separated list of Git URLs to clone into wp-content.
# Examples:
# PLUGINS_GIT_URLS="https://github.com/vendor/plugin-one.git https://github.com/vendor/plugin-two.git"
# THEMES_GIT_URLS="https://github.com/vendor/theme-one.git https://github.com/vendor/theme-two.git"
PLUGINS_GIT_URLS=
THEMES_GIT_URLS=

# Space-separated list of theme slugs to keep when running `make themes-reset`.
# Example: THEMES_KEEP="twentytwentyfour"
THEMES_KEEP=twentytwentyfour

# Optional WordPress dev blueprint (monorepo source next to wordpress/).
# When set, `make wp-fresh-start` clones this repo into WP_DEV_BLUEPRINT_DIR
# on the first run only, removes the nested .git, and seeds
# boilerplate-theme/.env WP_CONTENT_PATH to this project's wordpress/wp-content.
# Commit the cloned folder, then leave the URL empty unless you want a fresh clone
# (delete the folder first). Example:
# WP_DEV_BLUEPRINT_URL=https://github.com/jswebschmiede/Wordpress-Dev-Blueprint.git
WP_DEV_BLUEPRINT_URL=
WP_DEV_BLUEPRINT_DIR=dev
